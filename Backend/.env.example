# ==========================================
# NYAYASETU Backend Environment Variables
# Copy this file to .env and fill in real values
# ==========================================

# Django Configuration
DEBUG=True
SECRET_KEY=your-secure-django-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (PostgreSQL 15+ with pgvector)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=nyaysetu
DB_USER=suraj
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Neo4j Knowledge Graph Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password

# Embedding Configuration
# Fixed 768-dimensional model for dense semantic retrieval (BAAI/bge-base-en-v1.5)
EMBEDDING_MODEL_NAME=BAAI/bge-base-en-v1.5
EMBEDDING_DIMENSION=768

# LLM Assistant Configuration
# LLM_PROVIDER options: mock | gemini | openai
LLM_PROVIDER=mock
LLM_MODEL=gemini-1.5-flash
LLM_API_KEY=
